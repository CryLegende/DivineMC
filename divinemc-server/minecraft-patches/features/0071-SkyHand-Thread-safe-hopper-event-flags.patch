From: Cry_Legende <vaval1003@gmail.com>
Date: Thu, 12 Nov 2026 02:26:15 +0100
Subject: [PATCH] SkyHand: Thread-safe hopper event flags

Paper keeps the hopper move-event shortcuts (skipPullModeEventFire,
skipPushModeEventFire) and BlockEntity.ignoreBlockEntityUpdates in static
fields. With Regionized Chunk Ticking hopper minecarts tick on several
region threads at once, and with parallel world ticking every world has
its own thread: a move on one thread could flip the flag for another one,
which then moved items without firing InventoryMoveItemEvent (plugins such
as AdvancedChests never saw it) or skipped an unrelated setChanged.

The skip flags are now per thread. ignoreBlockEntityUpdates is per thread
too, behind a counter so setChanged stays on its fast path while no hopper
move is running, and it is reset in a finally block.

diff --git a/net/minecraft/world/level/block/entity/BlockEntity.java b/net/minecraft/world/level/block/entity/BlockEntity.java
index 25523192f01a483ba662f14ea9e528cd6b0781c0..1c48fc361f3720c9a4665978cfd430be5809db6e 100644
--- a/net/minecraft/world/level/block/entity/BlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BlockEntity.java
@@ -39,7 +39,28 @@ import org.jspecify.annotations.Nullable;
 import org.slf4j.Logger;
 
 public abstract class BlockEntity implements DebugValueSource, TypedInstance<BlockEntityType<?>>, net.caffeinemc.mods.lithium.common.block.entity.inventory_comparator_tracking.ComparatorTracker, net.caffeinemc.mods.lithium.common.block.entity.SetBlockStateHandlingBlockEntity, net.caffeinemc.mods.lithium.common.block.entity.SetChangedHandlingBlockEntity { // DivineMC - lithium: sleeping_block_entity
-    static boolean ignoreBlockEntityUpdates; // Paper - Perf: Optimize Hoppers
+    // Paper - Perf: Optimize Hoppers
+    // SkyHand start - Thread-safe hopper event flags
+    // Per thread: a hopper move on one region/world thread must not swallow another thread's setChanged. The counter
+    // keeps setChanged on its fast path (no ThreadLocal lookup) while no hopper move is in progress anywhere.
+    private static final java.util.concurrent.atomic.AtomicInteger IGNORE_UPDATES_WINDOWS = new java.util.concurrent.atomic.AtomicInteger();
+    private static final ThreadLocal<boolean[]> IGNORE_UPDATES_HERE = ThreadLocal.withInitial(() -> new boolean[1]);
+
+    static void ignoreBlockEntityUpdates(final boolean ignore) {
+        final boolean[] here = IGNORE_UPDATES_HERE.get();
+        if (here[0] == ignore) return;
+        here[0] = ignore;
+        if (ignore) {
+            IGNORE_UPDATES_WINDOWS.incrementAndGet();
+        } else {
+            IGNORE_UPDATES_WINDOWS.decrementAndGet();
+        }
+    }
+
+    private static boolean ignoreBlockEntityUpdates() {
+        return IGNORE_UPDATES_WINDOWS.get() != 0 && IGNORE_UPDATES_HERE.get()[0];
+    }
+    // SkyHand end - Thread-safe hopper event flags
     // CraftBukkit start - data containers
     private static final org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry DATA_TYPE_REGISTRY = new org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry();
     public final org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer persistentDataContainer;
@@ -211,7 +232,7 @@ public abstract class BlockEntity implements DebugValueSource, TypedInstance<Blo
 
     public void setChanged() {
         if (this.level != null) {
-            if (ignoreBlockEntityUpdates) return; // Paper - Perf: Optimize Hoppers
+            if (ignoreBlockEntityUpdates()) return; // Paper - Perf: Optimize Hoppers // SkyHand - Thread-safe hopper event flags
             setChanged(this.level, this.worldPosition, this.blockState);
             if (org.bxteam.divinemc.config.DivineConfig.PerformanceCategory.sleepingBlockEntity) lithium$handleSetChanged(); // DivineMC - lithium: sleeping_block_entity
         }
