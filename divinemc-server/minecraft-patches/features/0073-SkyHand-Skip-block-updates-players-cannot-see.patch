+    // SkyHand start - Skip block updates players cannot see
+    /**
+     * Whether a block change is kept from the players: the block looks exactly the same before and after, or it is a
+     * cactus grown where it cannot stay (a cactus farm), which breaks on the next tick. Every such change still marks
+     * the chunk unsaved and runs its game logic; only the client update is skipped. A client that receives a useless
+     * update rebuilds the 16x16x16 mesh around it, which is what costs frames next to big farms.
+     */
+    private boolean hideBlockUpdate(final BlockPos pos, final BlockState old, final BlockState current) {
+        if (old == current) {
+            return false; // a resend on purpose (block entity data, a plugin correcting a client): always sent
+        }
+        final Block block = current.getBlock();
+        if (block != old.getBlock()) {
+            // The grown cactus breaks one tick later (level event 2001: particles, sound, item), which players get
+            // as usual. If it is still there at the next broadcast, flushHiddenCacti sends it then.
+            if (block == Blocks.CACTUS && old.isAir() && !current.canSurvive(this, pos)) {
+                synchronized (this.hiddenCactiLock) {
+                    this.hiddenCactiThisTick.add(pos.immutable());
+                }
+                return true;
+            }
+            return false;
+        }
+        // Properties no block model, block entity packet or client logic reads (checked against the 26.3 blockstates)
+        if (block == Blocks.TRIPWIRE) {
+            return sameExcept(old, current, net.minecraft.world.level.block.TripWireBlock.POWERED, net.minecraft.world.level.block.TripWireBlock.DISARMED);
+        }
+        if (block == Blocks.HOPPER) {
+            return sameExcept(old, current, net.minecraft.world.level.block.HopperBlock.ENABLED, null);
+        }
+        if (block == Blocks.DISPENSER || block == Blocks.DROPPER) {
+            return sameExcept(old, current, net.minecraft.world.level.block.DispenserBlock.TRIGGERED, null);
+        }
+        if (block == Blocks.NOTE_BLOCK) {
+            return sameExcept(old, current, net.minecraft.world.level.block.NoteBlock.POWERED, null);
+        }
+        if (block instanceof net.minecraft.world.level.block.LeavesBlock) {
+            return sameExcept(old, current, net.minecraft.world.level.block.LeavesBlock.DISTANCE, net.minecraft.world.level.block.LeavesBlock.PERSISTENT);
+        }
+        if (block == Blocks.BEEHIVE || block == Blocks.BEE_NEST) {
+            // honey levels 0 to 4 share one model, honey drips only at 5
+            return old.getValue(net.minecraft.world.level.block.BeehiveBlock.HONEY_LEVEL) < net.minecraft.world.level.block.BeehiveBlock.MAX_HONEY_LEVELS
+                && current.getValue(net.minecraft.world.level.block.BeehiveBlock.HONEY_LEVEL) < net.minecraft.world.level.block.BeehiveBlock.MAX_HONEY_LEVELS
+                && sameExcept(old, current, net.minecraft.world.level.block.BeehiveBlock.HONEY_LEVEL, null);
+        }
+        return false;
+    }
+
+    private static boolean sameExcept(final BlockState a, final BlockState b, final net.minecraft.world.level.block.state.properties.Property<?> ignored, final net.minecraft.world.level.block.state.properties.Property<?> alsoIgnored) {
+        for (net.minecraft.world.level.block.state.properties.Property<?> property : a.getProperties()) {
+            if (property != ignored && property != alsoIgnored && !a.getValue(property).equals(b.getValue(property))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Called before each broadcast: a cactus hidden at the previous broadcast that did not break is sent now. */
+    public void flushHiddenCacti() {
+        final List<BlockPos> toCheck;
+        synchronized (this.hiddenCactiLock) {
+            if (this.hiddenCactiThisTick.isEmpty() && this.hiddenCactiLastTick.isEmpty()) {
+                return;
+            }
+            toCheck = this.hiddenCactiLastTick;
+            this.hiddenCactiLastTick = this.hiddenCactiThisTick;
+            this.hiddenCactiThisTick = new ArrayList<>();
+        }
+        for (final BlockPos pos : toCheck) {
+            final BlockState state = this.getBlockStateIfLoaded(pos);
+            if (state != null && state.is(Blocks.CACTUS)) {
+                this.getChunkSource().blockChanged(pos);
+            }
+        }
+    }
+    // SkyHand end - Skip block updates players cannot see
+
